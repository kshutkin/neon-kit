{
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kshutkin/neon-kit.git"
  },
  "scripts": {
    "build": "pnpm --aggregate-output --reporter=append-only --stream -r --if-present build",
    "lint": "pnpm --aggregate-output --reporter=append-only --stream --parallel -r --if-present lint",
    "test": "pnpm --aggregate-output --reporter=append-only --stream --parallel -r --if-present test",
    "ci:publish": "changeset publish",
    "dev": "vite",
    "start": "vite",
    "build:docs": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@neon-kit/icons": "workspace:*",
    "@neon-kit/theme": "workspace:*",
    "@neon-kit/web-components": "workspace:*",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^25.6.0",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "axe-core": "^4.12.0",
    "dts-buddy": "^0.7.0",
    "pkgprn": "^0.8.0",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.1.13",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
