{
    "name": "@neon-kit/jsx-components",
    "version": "0.0.1",
    "description": "JSX components implementing the Neon Kit theme.",
    "license": "MIT",
    "author": "Konstantin Shutkin",
    "type": "module",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./tooltip": {
            "types": "./types/index.d.ts",
            "default": "./dist/tooltip.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "types"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kshutkin/neon-kit.git",
        "directory": "jsx-components"
    },
    "bugs": "https://github.com/kshutkin/neon-kit/issues",
    "homepage": "https://github.com/kshutkin/neon-kit/blob/main/jsx-components/README.md",
    "readme": "README.md",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "rollup -c && tsc -p tsconfig.dts.json && dts-buddy types/index.d.ts -m @neon-kit/jsx-components:.dts/index.d.ts -m @neon-kit/jsx-components/tooltip:.dts/tooltip.d.ts",
        "prepack": "pkgprn --flatten types,dist",
        "test": "vitest run --coverage --config ../vitest.config.js",
        "test:types": "tsc -p tsconfig.types.json"
    },
    "peerDependencies": {
        "@slimlib/jsx": "^0.5.0",
        "@slimlib/store": "^2.2.1"
    },
    "dependencies": {
        "@neon-kit/core": "workspace:*",
        "esm-env": "^1.2.2"
    },
    "devDependencies": {
        "@rollup-extras/plugin-clean": "^2.0.1",
        "@rollup-extras/plugin-mangle": "^0.1.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "rollup": "^4.60.4",
        "rollup-plugin-esbuild": "^6.2.1"
    }
}
