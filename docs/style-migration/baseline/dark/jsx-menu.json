    "focus": "<body class=\"min-h-screen bg-surface text-ink-primary\">\n    <header class=\"docs-topbar\">\n        <a class=\"docs-wordmark\" data-docs-home=\"\" href=\"/neon-kit/\">Neon Kit</a>\n        <nav class=\"docs-topbar__nav\" aria-label=\"Documentation sections\">\n            <ul class=\"nav -segmented\" data-docs-nav=\"\">\n                <li><a data-docs-section=\"about\" href=\"/neon-kit/\" class=\"nav__item\">About</a></li>\n                <li><a data-docs-section=\"getting-started\" href=\"/neon-kit/getting-started/\" class=\"nav__item\">Getting Started</a></li>\n                <li><a data-docs-section=\"components\" href=\"/neon-kit/jsx-menu/\" class=\"nav__item -active\">Components</a></li>\n                <li><a data-docs-section=\"icons\" href=\"/neon-kit/icons/\" class=\"nav__item\">Icons</a></li>\n            </ul>\n        </nav>\n        <theme-switcher>\n      <div class=\"relative\">\n        <button class=\"btn theme-toggle-btn cursor-pointer text-sm\">\n          Theme &amp; Colors\n        </button>\n        <div class=\"theme-panel hidden absolute top-full right-0 mt-2 p-6 rounded-lg shadow-lg min-w-[280px] max-w-[320px] z-[1000]\" style=\"background: var(--color-surface); border: 1px solid var(--color-border);\">\n          <div class=\"mb-6\">\n            <h3 class=\"text-base font-semibold mb-4\" style=\"color: var(--color-ink-primary);\">Theme</h3>\n            <button class=\"btn cta theme-toggle w-full cursor-pointer\">\n              Toggle Light/Dark\n            </button>\n          </div>\n\n          <div class=\"pt-6\" style=\"border-top: 1px solid var(--color-border);\">\n            <h3 class=\"text-base font-semibold mb-4\" style=\"color: var(--color-ink-primary);\">Primary Color</h3>\n\n            <div class=\"mb-4\">\n              <div class=\"primary-color-preview w-full h-16 rounded-md mb-3 border-2\" style=\"background: var(--color-primary); border-color: var(--color-border);\"></div>\n              <div class=\"font-mono text-xs text-center mb-4 primary-oklch-display\" style=\"color: var(--color-ink-secondary);\">oklch(38% 0.2 245)</div>\n            </div>\n\n            <div class=\"mb-4\">\n              <label class=\"block text-sm mb-2\" style=\"color: var(--color-ink-primary);\">\n                Lightness: <span class=\"primary-l-value\">38</span>%\n              </label>\n              <input type=\"range\" class=\"primary-l-slider w-full\" min=\"0\" max=\"100\" value=\"38\" step=\"1\">\n            </div>\n\n            <div class=\"mb-4\">\n              <label class=\"block text-sm mb-2\" style=\"color: var(--color-ink-primary);\">\n                Chroma: <span class=\"primary-c-value\">0.2</span>\n              </label>\n              <input type=\"range\" class=\"primary-c-slider w-full\" min=\"0\" max=\"0.5\" value=\"0.2\" step=\"0.01\">\n            </div>\n\n            <div class=\"mb-4\">\n              <label class=\"block text-sm mb-2\" style=\"color: var(--color-ink-primary);\">\n                Hue: <span class=\"primary-h-value\">245</span>°\n              </label>\n              <input type=\"range\" class=\"primary-h-slider w-full\" min=\"0\" max=\"360\" value=\"245\" step=\"1\">\n            </div>\n            <button class=\"btn reset-primary-btn w-full mt-2 cursor-pointer\">\n              Reset to Default\n            </button>\n          </div>\n        </div>\n      </div>\n    </theme-switcher>\n    </header>\n    <aside class=\"docs-aside flex w-72 flex-col border-r border-border bg-surface-secondary\">\n        <nav class=\"flex-1 p-4\">\n            <ul class=\"nav -vertical\" data-sidebar=\"\">\n                <li data-item=\"buttons\"><a data-item=\"buttons\" data-slug=\"buttons\" href=\"/neon-kit/buttons/\" class=\"nav__item\">Buttons</a></li>\n                <li data-item=\"panels\"><a data-item=\"panels\" data-slug=\"panels\" href=\"/neon-kit/panels/\" class=\"nav__item\">Panels</a></li>\n                <li data-item=\"details\"><a data-item=\"details\" data-slug=\"details\" href=\"/neon-kit/details/\" class=\"nav__item\">Details</a></li>\n                <li data-item=\"dialogs\"><a data-item=\"dialogs\" data-slug=\"dialogs\" href=\"/neon-kit/dialogs/\" class=\"nav__item\">Dialogs</a></li>\n                <li data-item=\"menus\"><a data-item=\"menus\" data-slug=\"jsx-menu\" href=\"/neon-kit/jsx-menu/\" class=\"nav__item -active\">Menus</a></li>\n                <li data-item=\"navigation\"><a data-item=\"navigation\" data-slug=\"navigation\" href=\"/neon-kit/navigation/\" class=\"nav__item\">Navigation</a></li>\n                <li data-item=\"kbd\"><a data-item=\"kbd\" data-slug=\"kbd\" href=\"/neon-kit/kbd/\" class=\"nav__item\">Keyboard</a></li>\n                <li data-item=\"badges\"><a data-item=\"badges\" data-slug=\"badges\" href=\"/neon-kit/badges/\" class=\"nav__item\">Badges</a></li>\n                <li data-item=\"tags\"><a data-item=\"tags\" data-slug=\"tags\" href=\"/neon-kit/tags/\" class=\"nav__item\">Tags</a></li>\n                <li data-item=\"forms\"><a data-item=\"forms\" data-slug=\"forms\" href=\"/neon-kit/forms/\" class=\"nav__item\">Forms</a></li>\n                <li data-item=\"combobox-single\"><a data-item=\"combobox-single\" data-slug=\"combobox-single\" href=\"/neon-kit/combobox-single/\" class=\"nav__item\">Combobox — Single</a></li>\n                <li data-item=\"combobox-multi\"><a data-item=\"combobox-multi\" data-slug=\"combobox-multi\" href=\"/neon-kit/combobox-multi/\" class=\"nav__item\">Combobox — Multi</a></li>\n                <li data-item=\"datepicker\"><a data-item=\"datepicker\" data-slug=\"datepicker\" href=\"/neon-kit/datepicker/\" class=\"nav__item\">Datepicker</a></li>\n                <li data-item=\"datepicker-range\"><a data-item=\"datepicker-range\" data-slug=\"datepicker-range\" href=\"/neon-kit/datepicker-range/\" class=\"nav__item\">Datepicker — Range</a></li>\n                <li data-item=\"timepicker\"><a data-item=\"timepicker\" data-slug=\"timepicker\" href=\"/neon-kit/timepicker/\" class=\"nav__item\">Timepicker</a></li>\n                <li data-item=\"tooltip\"><a data-item=\"tooltip\" data-slug=\"jsx-tooltip\" href=\"/neon-kit/jsx-tooltip/\" class=\"nav__item\">Tooltip</a></li>\n                <li data-item=\"typography\"><a data-item=\"typography\" data-slug=\"typography\" href=\"/neon-kit/typography/\" class=\"nav__item\">Typography</a></li>\n                <li data-item=\"tables\"><a data-item=\"tables\" data-slug=\"tables\" href=\"/neon-kit/tables/\" class=\"nav__item\">Tables</a></li>\n                <li data-item=\"colors\"><a data-item=\"colors\" data-slug=\"colors\" href=\"/neon-kit/colors/\" class=\"nav__item\">Colors</a></li>\n                <li data-item=\"links\"><a data-item=\"links\" data-slug=\"links\" href=\"/neon-kit/links/\" class=\"nav__item\">Links</a></li>\n                <li data-item=\"shadows\"><a data-item=\"shadows\" data-slug=\"shadows\" href=\"/neon-kit/shadows/\" class=\"nav__item\">Shadows</a></li>\n                <li data-item=\"utilities\"><a data-item=\"utilities\" data-slug=\"utilities\" href=\"/neon-kit/utilities/\" class=\"nav__item\">Utilities</a></li>\n            </ul>\n        </nav>\n    </aside>\n    <main id=\"content\" class=\"docs-main bg-surface\">\n        <nav data-component-mode-nav=\"\" aria-label=\"Component mode\" class=\"docs-tabs\">\n            <ul class=\"nav -tabs\">\n                <li><a data-section=\"css\" href=\"/neon-kit/menus/\" class=\"nav__item\">CSS</a></li>\n                <li><a data-section=\"wc\" href=\"/neon-kit/wc-menu/\" class=\"nav__item\">Web Components</a></li>\n                <li><a data-section=\"jsx\" href=\"/neon-kit/jsx-menu/\" class=\"nav__item -active\">JSX</a></li>\n            </ul>\n        </nav>\n        <div id=\"content-inner\" class=\"p-8\"><main>\n    <h1 class=\"mb-6\">Menu — JSX</h1>\n    <p class=\"mb-6 text-ink-secondary\">\n        <code>Menu</code> decorates one button trigger and renders a sibling\n        native popover containing <code>MenuItem</code> buttons. It shares the\n        same roving focus, keyboard navigation, nested-menu coordination, and\n        accessible labelling behavior as <code>&lt;neon-menu&gt;</code>.\n    </p>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">Installation</h2>\n        <pre class=\"rounded-lg border border-border bg-surface-secondary p-4\"><code>pnpm add @neon-kit/theme @neon-kit/jsx-components @slimlib/jsx\n\nimport '@neon-kit/theme/index.css';\nimport { Menu, MenuItem } from '@neon-kit/jsx-components/menu';</code></pre>\n    </section>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">Basic</h2>\n        <p class=\"mb-4 text-ink-secondary\">\n            Pass one button as the trigger and menu JSX as <code>content</code>.\n            The component wires IDs, <code>popovertarget</code>, menu roles, and\n            labelling automatically.\n        </p>\n        <div class=\"rounded-lg border border-border bg-surface-secondary p-6\" data-jsx-menu-demo=\"basic\"><button type=\"button\" class=\"btn\" popovertarget=\"neon-menu-a65are66g\" id=\"neon-menu-trigger-9tksspy58\">Actions</button><div id=\"neon-menu-a65are66g\" class=\"menu\" role=\"menu\" popover=\"auto\" aria-labelledby=\"neon-menu-trigger-9tksspy58\"><div class=\"menu__group\"><button type=\"button\" class=\"menu__item\" role=\"menuitem\" tabindex=\"0\">New file<span class=\"menu__shortcut kbd-keys\"><kbd class=\"kbd\">⌘</kbd><kbd class=\"kbd\">N</kbd></span></button><button type=\"button\" class=\"menu__item\" role=\"menuitem\" tabindex=\"-1\">Open</button><button type=\"button\" class=\"menu__item\" role=\"menuitem\" aria-disabled=\"true\" tabindex=\"-1\">Delete</button></div></div></div>\n        <pre class=\"mt-4 rounded-lg border border-border bg-surface-secondary p-4\"><code>&lt;Menu\n    content={\n        &lt;div class=\"menu__group\"&gt;\n            &lt;MenuItem onClick={createFile}&gt;New file&lt;/MenuItem&gt;\n            &lt;MenuItem&gt;Open&lt;/MenuItem&gt;\n            &lt;MenuItem disabled&gt;Delete&lt;/MenuItem&gt;\n        &lt;/div&gt;\n    }\n&gt;\n    &lt;button type=\"button\" class=\"btn\"&gt;Actions&lt;/button&gt;\n&lt;/Menu&gt;</code></pre>\n    </section>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">Nested menus</h2>\n        <p class=\"mb-4 text-ink-secondary\">\n            Use a <code>MenuItem</code> as another <code>Menu</code>'s trigger.\n            <kbd class=\"kbd\">→</kbd> opens the submenu,\n            <kbd class=\"kbd\">←</kbd> returns to its parent item, and activating\n            a leaf closes the complete open menu tree.\n        </p>\n        <div class=\"rounded-lg border border-border bg-surface-secondary p-6\" data-jsx-menu-demo=\"nested\"><button type=\"button\" class=\"btn\" popovertarget=\"neon-menu-7aqhmeo5j\" id=\"neon-menu-trigger-rpxcjdplp\">Project actions</button><div id=\"neon-menu-7aqhmeo5j\" class=\"menu\" role=\"menu\" popover=\"auto\" aria-labelledby=\"neon-menu-trigger-rpxcjdplp\"><div class=\"menu__group\"><button type=\"button\" class=\"menu__item\" role=\"menuitem\" tabindex=\"0\">Rename</button><button type=\"button\" class=\"menu__item\" role=\"menuitem\" popovertarget=\"neon-menu-m2okuuta0\" aria-haspopup=\"menu\" aria-expanded=\"false\" id=\"neon-menu-trigger-8zo1k1avd\" tabindex=\"-1\">Export as<svg class=\"menu__chevron\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m8.25 4.5 7.5 7.5-7.5 7.5\"></path></svg></button><div id=\"neon-menu-m2okuuta0\" class=\"menu -inline-end\" role=\"menu\" popover=\"auto\" aria-labelledby=\"neon-menu-trigger-8zo1k1avd\"><div class=\"menu__group\"><button type=\"button\" class=\"menu__item\" role=\"menuitem\" tabindex=\"0\">PDF document</button><button type=\"button\" class=\"menu__item\" role=\"menuitem\" tabindex=\"-1\">Markdown file</button></div></div><button type=\"button\" class=\"menu__item\" role=\"menuitem\" tabindex=\"-1\">Archive</button></div></div></div>\n    </section>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">API</h2>\n        <ul class=\"list-disc pl-6 text-ink-secondary\">\n            <li><code>Menu.children</code>: exactly one <code>HTMLButtonElement</code> trigger.</li>\n            <li><code>Menu.content</code>: JSX containing owned <code>MenuItem</code> descendants.</li>\n            <li><code>Menu.placement</code>: <code>block-end</code>, <code>block-start</code>, <code>inline-end</code>, or <code>inline-start</code>.</li>\n            <li><code>MenuItem.disabled</code>: creates focusable <code>aria-disabled=\"true\"</code> state and suppresses activation.</li>\n            <li><code>MenuItem.onClick</code>: runs for enabled item activation before leaf menus close.</li>\n        </ul>\n    </section>\n</main>\n</div>\n    </main>\n    <script src=\"/neon-kit/theme-switcher.js\" type=\"module\"></script>\n    <script src=\"/neon-kit/combobox.js\" type=\"module\"></script>\n    <script src=\"/neon-kit/datepicker.js\" type=\"module\"></script>\n    <script src=\"/neon-kit/timepicker.js\" type=\"module\"></script>\n    <script src=\"/neon-kit/jsx-menu.jsx\" type=\"module\"></script>\n    <script src=\"/neon-kit/jsx-tooltip.jsx\" type=\"module\"></script>\n    <script src=\"/neon-kit/icons.js\" type=\"module\"></script>\n    <script src=\"/neon-kit/wc.js\" type=\"module\"></script>\n    <script type=\"module\" src=\"/neon-kit/index.html?html-proxy&amp;index=0.js\"></script>\n\n\n</body>",
