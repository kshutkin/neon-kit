    "focus": "<body class=\"min-h-screen bg-surface text-ink-primary\">\n    <header class=\"docs-topbar\">\n        <a class=\"docs-wordmark\" data-docs-home=\"\" href=\"/neon-kit/\">Neon Kit</a>\n        <nav class=\"docs-topbar__nav\" aria-label=\"Documentation sections\">\n            <ul class=\"nav -segmented\" data-docs-nav=\"\">\n                <li><a data-docs-section=\"about\" href=\"/neon-kit/\" class=\"nav__item\">About</a></li>\n                <li><a data-docs-section=\"getting-started\" href=\"/neon-kit/getting-started/\" class=\"nav__item\">Getting Started</a></li>\n                <li><a data-docs-section=\"components\" href=\"/neon-kit/navigation/\" class=\"nav__item -active\">Components</a></li>\n                <li><a data-docs-section=\"icons\" href=\"/neon-kit/icons/\" class=\"nav__item\">Icons</a></li>\n            </ul>\n        </nav>\n        <theme-switcher>\n      <div class=\"relative\">\n        <button class=\"btn theme-toggle-btn cursor-pointer text-sm\">\n          Theme &amp; Colors\n        </button>\n        <div class=\"theme-panel hidden absolute top-full right-0 mt-2 p-6 rounded-lg shadow-lg min-w-[280px] max-w-[320px] z-[1000]\" style=\"background: var(--color-surface); border: 1px solid var(--color-border);\">\n          <div class=\"mb-6\">\n            <h3 class=\"text-base font-semibold mb-4\" style=\"color: var(--color-ink-primary);\">Theme</h3>\n            <button class=\"btn cta theme-toggle w-full cursor-pointer\">\n              Toggle Light/Dark\n            </button>\n          </div>\n\n          <div class=\"pt-6\" style=\"border-top: 1px solid var(--color-border);\">\n            <h3 class=\"text-base font-semibold mb-4\" style=\"color: var(--color-ink-primary);\">Primary Color</h3>\n\n            <div class=\"mb-4\">\n              <div class=\"primary-color-preview w-full h-16 rounded-md mb-3 border-2\" style=\"background: var(--color-primary); border-color: var(--color-border);\"></div>\n              <div class=\"font-mono text-xs text-center mb-4 primary-oklch-display\" style=\"color: var(--color-ink-secondary);\">oklch(38% 0.2 245)</div>\n            </div>\n\n            <div class=\"mb-4\">\n              <label class=\"block text-sm mb-2\" style=\"color: var(--color-ink-primary);\">\n                Lightness: <span class=\"primary-l-value\">38</span>%\n              </label>\n              <input type=\"range\" class=\"primary-l-slider w-full\" min=\"0\" max=\"100\" value=\"38\" step=\"1\">\n            </div>\n\n            <div class=\"mb-4\">\n              <label class=\"block text-sm mb-2\" style=\"color: var(--color-ink-primary);\">\n                Chroma: <span class=\"primary-c-value\">0.2</span>\n              </label>\n              <input type=\"range\" class=\"primary-c-slider w-full\" min=\"0\" max=\"0.5\" value=\"0.2\" step=\"0.01\">\n            </div>\n\n            <div class=\"mb-4\">\n              <label class=\"block text-sm mb-2\" style=\"color: var(--color-ink-primary);\">\n                Hue: <span class=\"primary-h-value\">245</span>°\n              </label>\n              <input type=\"range\" class=\"primary-h-slider w-full\" min=\"0\" max=\"360\" value=\"245\" step=\"1\">\n            </div>\n            <button class=\"btn reset-primary-btn w-full mt-2 cursor-pointer\">\n              Reset to Default\n            </button>\n          </div>\n        </div>\n      </div>\n    </theme-switcher>\n    </header>\n    <aside class=\"docs-aside flex w-72 flex-col border-r border-border bg-surface-secondary\">\n        <nav class=\"flex-1 p-4\">\n            <ul class=\"nav -vertical\" data-sidebar=\"\">\n                <li data-item=\"buttons\"><a data-item=\"buttons\" data-slug=\"buttons\" href=\"/neon-kit/buttons/\" class=\"nav__item\">Buttons</a></li>\n                <li data-item=\"panels\"><a data-item=\"panels\" data-slug=\"panels\" href=\"/neon-kit/panels/\" class=\"nav__item\">Panels</a></li>\n                <li data-item=\"details\"><a data-item=\"details\" data-slug=\"details\" href=\"/neon-kit/details/\" class=\"nav__item\">Details</a></li>\n                <li data-item=\"dialogs\"><a data-item=\"dialogs\" data-slug=\"dialogs\" href=\"/neon-kit/dialogs/\" class=\"nav__item\">Dialogs</a></li>\n                <li data-item=\"menus\"><a data-item=\"menus\" data-slug=\"menus\" href=\"/neon-kit/menus/\" class=\"nav__item\">Menus</a></li>\n                <li data-item=\"navigation\"><a data-item=\"navigation\" data-slug=\"navigation\" href=\"/neon-kit/navigation/\" class=\"nav__item -active\">Navigation</a></li>\n                <li data-item=\"kbd\"><a data-item=\"kbd\" data-slug=\"kbd\" href=\"/neon-kit/kbd/\" class=\"nav__item\">Keyboard</a></li>\n                <li data-item=\"badges\"><a data-item=\"badges\" data-slug=\"badges\" href=\"/neon-kit/badges/\" class=\"nav__item\">Badges</a></li>\n                <li data-item=\"tags\"><a data-item=\"tags\" data-slug=\"tags\" href=\"/neon-kit/tags/\" class=\"nav__item\">Tags</a></li>\n                <li data-item=\"forms\"><a data-item=\"forms\" data-slug=\"forms\" href=\"/neon-kit/forms/\" class=\"nav__item\">Forms</a></li>\n                <li data-item=\"combobox-single\"><a data-item=\"combobox-single\" data-slug=\"combobox-single\" href=\"/neon-kit/combobox-single/\" class=\"nav__item\">Combobox — Single</a></li>\n                <li data-item=\"combobox-multi\"><a data-item=\"combobox-multi\" data-slug=\"combobox-multi\" href=\"/neon-kit/combobox-multi/\" class=\"nav__item\">Combobox — Multi</a></li>\n                <li data-item=\"datepicker\"><a data-item=\"datepicker\" data-slug=\"datepicker\" href=\"/neon-kit/datepicker/\" class=\"nav__item\">Datepicker</a></li>\n                <li data-item=\"datepicker-range\"><a data-item=\"datepicker-range\" data-slug=\"datepicker-range\" href=\"/neon-kit/datepicker-range/\" class=\"nav__item\">Datepicker — Range</a></li>\n                <li data-item=\"timepicker\"><a data-item=\"timepicker\" data-slug=\"timepicker\" href=\"/neon-kit/timepicker/\" class=\"nav__item\">Timepicker</a></li>\n                <li data-item=\"tooltip\"><a data-item=\"tooltip\" data-slug=\"tooltip\" href=\"/neon-kit/tooltip/\" class=\"nav__item\">Tooltip</a></li>\n                <li data-item=\"typography\"><a data-item=\"typography\" data-slug=\"typography\" href=\"/neon-kit/typography/\" class=\"nav__item\">Typography</a></li>\n                <li data-item=\"tables\"><a data-item=\"tables\" data-slug=\"tables\" href=\"/neon-kit/tables/\" class=\"nav__item\">Tables</a></li>\n                <li data-item=\"colors\"><a data-item=\"colors\" data-slug=\"colors\" href=\"/neon-kit/colors/\" class=\"nav__item\">Colors</a></li>\n                <li data-item=\"links\"><a data-item=\"links\" data-slug=\"links\" href=\"/neon-kit/links/\" class=\"nav__item\">Links</a></li>\n                <li data-item=\"shadows\"><a data-item=\"shadows\" data-slug=\"shadows\" href=\"/neon-kit/shadows/\" class=\"nav__item\">Shadows</a></li>\n                <li data-item=\"utilities\"><a data-item=\"utilities\" data-slug=\"utilities\" href=\"/neon-kit/utilities/\" class=\"nav__item\">Utilities</a></li>\n            </ul>\n        </nav>\n    </aside>\n    <main id=\"content\" class=\"docs-main bg-surface\">\n        <nav data-component-mode-nav=\"\" aria-label=\"Component mode\" class=\"docs-tabs\">\n            <ul class=\"nav -tabs\">\n                <li><a data-section=\"css\" href=\"/neon-kit/navigation/\" class=\"nav__item -active\">CSS</a></li>\n                <li hidden=\"\"><a data-section=\"wc\" class=\"nav__item\">Web Components</a></li>\n                <li hidden=\"\"><a data-section=\"jsx\" class=\"nav__item\">JSX</a></li>\n            </ul>\n        </nav>\n        <div id=\"content-inner\" class=\"p-8\"><main>\n    <h1 class=\"mb-6\">Navigation Component</h1>\n    <p class=\"mb-6 text-ink-secondary\">\n        Element-agnostic interactive rows for sidebar navigation, horizontal tabs, and\n        radio-input segmented controls. Selectors target <code>.nav__item</code>, so the\n        same styles work on <code>&lt;a&gt;</code>, <code>&lt;button&gt;</code>,\n        <code>&lt;label&gt;</code>, <code>&lt;li&gt;</code>, or <code>&lt;div&gt;</code> —\n        choose the most semantic element for each use-case. Active state is opt-in via the\n        <code>.-active</code> modifier; ARIA hooks like <code>aria-current</code> and\n        <code>aria-selected</code> are author concerns and are styled independently.\n    </p>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">Sidebar (vertical)</h2>\n        <p class=\"mb-4 text-ink-secondary\">\n            Flat surface — no panel elevation. Best as a section landmark with\n            <code>&lt;nav&gt;</code> wrapping a <code>&lt;ul&gt;</code> of links. The\n            active row carries both <code>.-active</code> (visuals) and\n            <code>aria-current=\"page\"</code> (semantics).\n        </p>\n        <div class=\"rounded-lg border border-border bg-surface-secondary p-6\">\n            <nav aria-label=\"Primary\" class=\"w-64\">\n                <ul class=\"nav -vertical\">\n                    <li><a href=\"#overview\" class=\"nav__item\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\" class=\"size-4\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M2.25 12 12 2.25 21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25\"></path></svg>\n                        <span>Overview</span>\n                    </a></li>\n                    <li><a href=\"#components\" class=\"nav__item -active\" aria-current=\"page\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\" class=\"size-4\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z\"></path></svg>\n                        <span>Components</span>\n                    </a></li>\n                    <li><a href=\"#tokens\" class=\"nav__item\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\" class=\"size-4\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z\"></path></svg>\n                        <span>Tokens</span>\n                    </a></li>\n                    <li><a href=\"#changelog\" class=\"nav__item\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\" class=\"size-4\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z\"></path></svg>\n                        <span>Changelog</span>\n                    </a></li>\n                    <li><a href=\"#disabled\" class=\"nav__item\" aria-disabled=\"true\">\n                        <span>Coming soon</span>\n                    </a></li>\n                </ul>\n            </nav>\n        </div>\n    </section>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">Sidebar on plain <code>&lt;div&gt;</code> rows</h2>\n        <p class=\"mb-4 text-ink-secondary\">\n            Selectors don't depend on element type — but plain <code>&lt;div&gt;</code>s\n            aren't focusable or activatable. Prefer <code>&lt;a&gt;</code> or\n            <code>&lt;button&gt;</code> for any clickable nav. This is shown only to\n            illustrate the styles attach to the class.\n        </p>\n        <div class=\"rounded-lg border border-border bg-surface-secondary p-6\">\n            <div class=\"nav -vertical w-64\">\n                <div class=\"nav__item\">First</div>\n                <div class=\"nav__item -active\">Second (active)</div>\n                <div class=\"nav__item\">Third</div>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">Tabs (horizontal, elevated surface)</h2>\n        <p class=\"mb-4 text-ink-secondary\">\n            The tab bar and the content area form a single connected, elevated surface\n            (button/panel chrome). The active tab pops up to the surface color and merges\n            into the content panel below. Use <code>&lt;button role=\"tab\"&gt;</code> for\n            in-page tab switching with <code>aria-selected</code>, paired with\n            <code>.-active</code> for visuals.\n        </p>\n        <div class=\"rounded-lg border border-border bg-surface-secondary p-6\">\n            <div role=\"tablist\" aria-label=\"Settings sections\" class=\"nav -tabs\">\n                <button type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"nav__item -active\">Profile</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"nav__item\">Account</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"nav__item\">Notifications</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"nav__item\" aria-disabled=\"true\" disabled=\"\">Billing</button>\n            </div>\n            <div role=\"tabpanel\" class=\"rounded-b-lg border border-border bg-surface p-6 shadow-drop\">\n                <p class=\"text-ink-secondary\">\n                    Profile panel content. Tab bar and panel share the same elevated\n                    surface — consistent with buttons and <code>.panel</code>.\n                </p>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">Tabs as router links</h2>\n        <p class=\"mb-4 text-ink-secondary\">\n            Same visuals, different element. Use <code>&lt;a href&gt;</code> with\n            <code>aria-current=\"page\"</code> when each tab is a distinct URL.\n        </p>\n        <div class=\"rounded-lg border border-border bg-surface-secondary p-6\">\n            <nav aria-label=\"Sections\" class=\"nav -tabs\">\n                <a href=\"#docs\" class=\"nav__item -active\" aria-current=\"page\">Docs</a>\n                <a href=\"#api\" class=\"nav__item\">API</a>\n                <a href=\"#examples\" class=\"nav__item\">Examples</a>\n            </nav>\n        </div>\n    </section>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">Segmented control (radio-backed)</h2>\n        <p class=\"mb-4 text-ink-secondary\">\n            A recessed track with a raised \"thumb\" on the checked option. Backed by a\n            real <code>&lt;fieldset&gt;</code> of <code>&lt;input type=\"radio\"&gt;</code>s\n            so it submits with forms and works without JavaScript. The checked input's\n            visual focus ring is mirrored onto the visible <code>&lt;label&gt;</code>.\n        </p>\n        <div class=\"rounded-lg border border-border bg-surface-secondary p-6\">\n            <fieldset class=\"border-0 p-0 m-0\">\n                <legend class=\"sr-only\">View density</legend>\n                <div class=\"nav -segmented\">\n                    <input type=\"radio\" id=\"density-compact\" name=\"density\" value=\"compact\" class=\"sr-only\">\n                    <label for=\"density-compact\" class=\"nav__item\">Compact</label>\n\n                    <input type=\"radio\" id=\"density-cozy\" name=\"density\" value=\"cozy\" class=\"sr-only\" checked=\"\">\n                    <label for=\"density-cozy\" class=\"nav__item\">Cozy</label>\n\n                    <input type=\"radio\" id=\"density-comfy\" name=\"density\" value=\"comfy\" class=\"sr-only\">\n                    <label for=\"density-comfy\" class=\"nav__item\">Comfortable</label>\n                </div>\n            </fieldset>\n        </div>\n    </section>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">Segmented control (button-backed)</h2>\n        <p class=\"mb-4 text-ink-secondary\">\n            For client-only state (e.g. a chart-range picker) without a form, use\n            <code>&lt;button&gt;</code>s and toggle <code>.-active</code> /\n            <code>aria-pressed</code> in JavaScript.\n        </p>\n        <div class=\"rounded-lg border border-border bg-surface-secondary p-6\">\n            <div role=\"group\" aria-label=\"Time range\" class=\"nav -segmented\">\n                <button type=\"button\" class=\"nav__item\">1D</button>\n                <button type=\"button\" class=\"nav__item -active\" aria-pressed=\"true\">1W</button>\n                <button type=\"button\" class=\"nav__item\">1M</button>\n                <button type=\"button\" class=\"nav__item\">1Y</button>\n                <button type=\"button\" class=\"nav__item\">All</button>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"mb-8\">\n        <h2 class=\"mb-4\">RTL</h2>\n        <p class=\"mb-4 text-ink-secondary\">\n            All variants flip naturally — flexbox honors the writing direction; padding\n            and gaps are logical. No additional rules required.\n        </p>\n        <div dir=\"rtl\" class=\"rounded-lg border border-border bg-surface-secondary p-6 space-y-6\">\n            <nav aria-label=\"القائمة\" class=\"w-64\">\n                <ul class=\"nav -vertical\">\n                    <li><a href=\"#\" class=\"nav__item -active\" aria-current=\"page\">نظرة عامة</a></li>\n                    <li><a href=\"#\" class=\"nav__item\">المكونات</a></li>\n                    <li><a href=\"#\" class=\"nav__item\">الرموز</a></li>\n                </ul>\n            </nav>\n\n            <div role=\"tablist\" class=\"nav -tabs\">\n                <button type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"nav__item -active\">الملف</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"nav__item\">الحساب</button>\n                <button type=\"button\" role=\"tab\" aria-selected=\"false\" class=\"nav__item\">الإشعارات</button>\n            </div>\n\n            <div role=\"group\" class=\"nav -segmented\">\n                <button type=\"button\" class=\"nav__item -active\">يوم</button>\n                <button type=\"button\" class=\"nav__item\">أسبوع</button>\n                <button type=\"button\" class=\"nav__item\">شهر</button>\n            </div>\n        </div>\n    </section>\n</main>\n</div>\n    </main>\n    <script src=\"/neon-kit/theme-switcher.js\" type=\"module\"></script>\n    <script src=\"/neon-kit/combobox.js\" type=\"module\"></script>\n    <script src=\"/neon-kit/datepicker.js\" type=\"module\"></script>\n    <script src=\"/neon-kit/timepicker.js\" type=\"module\"></script>\n    <script src=\"/neon-kit/jsx-menu.jsx\" type=\"module\"></script>\n    <script src=\"/neon-kit/jsx-tooltip.jsx\" type=\"module\"></script>\n    <script src=\"/neon-kit/icons.js\" type=\"module\"></script>\n    <script src=\"/neon-kit/wc.js\" type=\"module\"></script>\n    <script type=\"module\" src=\"/neon-kit/index.html?html-proxy&amp;index=0.js\"></script>\n\n\n</body>",
    "fontFamily": "\"Hanken Grotesk\", sans-serif"
  },
