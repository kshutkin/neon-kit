{
    "version": "0.0.1",
    "license": "MIT",
    "name": "@neon-kit/web-components",
    "author": "Konstantin Shutkin",
    "type": "module",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./tooltip": {
            "types": "./types/index.d.ts",
            "default": "./dist/tooltip.js"
        },
        "./menu": {
            "types": "./types/index.d.ts",
            "default": "./dist/menu.js"
        },
        "./combobox": {
            "types": "./types/index.d.ts",
            "default": "./dist/combobox.js"
        },
        "./multicombobox": {
            "types": "./types/index.d.ts",
            "default": "./dist/multicombobox.js"
        },
        "./datepicker": {
            "types": "./types/index.d.ts",
            "default": "./dist/datepicker.js"
        },
        "./timepicker": {
            "types": "./types/index.d.ts",
            "default": "./dist/timepicker.js"
        },
        "./icon": {
            "types": "./types/index.d.ts",
            "default": "./dist/icon.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "files": [
        "dist",
        "types"
    ],
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kshutkin/neon-kit.git",
        "directory": "web-components"
    },
    "bugs": "https://github.com/kshutkin/neon-kit/issues",
    "homepage": "https://github.com/kshutkin/neon-kit/blob/main/web-components/README.md",
    "readme": "README.md",
    "description": "Web components implementing parts of the @neon-kit/theme as native custom elements.",
    "keywords": [
        "web-components",
        "custom-elements",
        "neon",
        "theme"
    ],
    "scripts": {
        "build": "rollup -c && tsc -p tsconfig.dts.json && dts-buddy types/index.d.ts -m @neon-kit/web-components:.dts/index.d.ts -m @neon-kit/web-components/tooltip:.dts/tooltip.d.ts -m @neon-kit/web-components/menu:.dts/menu.d.ts -m @neon-kit/web-components/combobox:.dts/combobox.d.ts -m @neon-kit/web-components/multicombobox:.dts/multicombobox.d.ts -m @neon-kit/web-components/datepicker:.dts/datepicker.d.ts -m @neon-kit/web-components/timepicker:.dts/timepicker.d.ts -m @neon-kit/web-components/icon:.dts/icon.d.ts && node scripts/append-globals.mjs",
        "prepack": "pkgprn --flatten types,dist",
        "test": "vitest run --coverage --config ../vitest.config.js",
        "test:types": "tsc -p tsconfig.types.json"
    },
    "dependencies": {
        "@neon-kit/icons": "workspace:*",
        "@slimlib/element": "^0.1.1",
        "@slimlib/jsx": "^0.1.0",
        "@slimlib/store": "^2.1.0",
        "esm-env": "^1.2.2"
    },
    "devDependencies": {
        "@rollup-extras/plugin-clean": "^2.0.1",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "rollup": "^4.60.4",
        "rollup-plugin-esbuild": "^6.2.1"
    }
}
