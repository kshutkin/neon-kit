{
    "name": "@neon-kit/core",
    "version": "0.0.1",
    "description": "Framework-agnostic behavior and DOM primitives for Neon Kit.",
    "license": "MIT",
    "author": "Konstantin Shutkin",
    "type": "module",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./src/index.js"
        },
        "./tooltip": {
            "types": "./types/index.d.ts",
            "default": "./src/tooltip.js"
        },
        "./menu": {
            "types": "./types/index.d.ts",
            "default": "./src/menu.js"
        },
        "./utils": {
            "types": "./types/index.d.ts",
            "default": "./src/utils.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "types"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kshutkin/neon-kit.git",
        "directory": "core"
    },
    "bugs": "https://github.com/kshutkin/neon-kit/issues",
    "homepage": "https://github.com/kshutkin/neon-kit/blob/main/core/README.md",
    "readme": "README.md",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.dts.json && dts-buddy types/index.d.ts -m @neon-kit/core:.dts/index.d.ts -m @neon-kit/core/menu:.dts/menu.d.ts -m @neon-kit/core/tooltip:.dts/tooltip.d.ts -m @neon-kit/core/utils:.dts/utils.d.ts",
        "prepack": "pkgprn --flatten types,src",
        "test": "vitest run --coverage --config ../vitest.config.js",
        "test:types": "tsc -p tsconfig.types.json"
    },
    "dependencies": {
        "esm-env": "^1.2.2"
    }
}
